<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">색반전 타이머</string>
    <string name="accessibility_service_label">앱 감시 서비스</string>
    <string name="accessibility_service_description">유튜브, 인스타그램 실행을 감지하여 색반전 및 5분 타이머를 적용합니다.</string>

    <string name="intro">유튜브 또는 인스타그램을 실행하면 10초 대기 후 색반전이 적용되고, 5분 후 자동으로 홈으로 이동합니다.</string>

    <string name="step_overlay">1. 다른 앱 위에 표시</string>
    <string name="step_accessibility">2. 접근성 서비스</string>
    <string name="step_secure">3. 시스템 색반전 권한 (ADB)</string>

    <string name="btn_overlay">권한 설정 열기</string>
    <string name="btn_accessibility">접근성 설정 열기</string>

    <string name="status_granted">상태: 허용됨</string>
    <string name="status_required">상태: 권한 필요</string>
    <string name="status_adb_required">상태: ADB 명령으로 부여 필요 (없으면 어둡게 표시로 대체)</string>

    <string name="adb_command">adb shell pm grant com.example.inversiontimer android.permission.WRITE_SECURE_SETTINGS</string>

    <string name="countdown_title">잠시만요. 정말 사용하시겠어요?</string>
    <string name="countdown_hint">10초 후 자동으로 잠금이 해제됩니다.</string>

    <string name="footer_note">※ 5분이 지나면 자동으로 홈 화면으로 이동합니다.</string>
</resources>
