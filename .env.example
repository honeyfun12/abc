# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC...
# Get your chat ID by sending any message to the bot, then visiting:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# --- Voice (optional, set TTS_ENABLED=false in config.yaml to skip) ---
OPENAI_API_KEY=sk-...

# --- Google integrations (optional) ---
# Place client_secret.json next to this file (download from Google Cloud Console).
# On first run, OAuth tokens will be saved to .google_token.json.
GOOGLE_CLIENT_SECRET_PATH=./client_secret.json
GOOGLE_TOKEN_PATH=./.google_token.json

# --- Behavior ---
TIMEZONE=Asia/Seoul
